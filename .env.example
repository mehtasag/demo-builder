# Copy to .env and fill in. .env is gitignored.

# Required.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/demobuilder

# Dropbox is optional. Without it the app runs local-only and the Dropbox UI
# reports "not configured". Run `pnpm dropbox:setup` to fill these in.
DROPBOX_FOLDER=/DemoBuilder
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

# Alternative to the three keys above: a token from the Dropbox App Console.
# Expires after ~4 hours. Ignored when a refresh token is set.
DROPBOX_ACCESS_TOKEN=
